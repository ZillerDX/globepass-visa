      "TH_US_en": {
        "from_country": "TH",
        "to_country": "US",
        "lang": "en",
        "visa_type": "embassy_visa",
        "stay_duration": "Up to 6 months per entry (determined by CBP officer)",
        "processing_time": "Several weeks to months for appointment scheduling; 3-5 business days post-interview for processing",
        "estimated_cost": "USD 185",
        "official_portal_url": "https://travel.state.gov/content/travel/en/us-visas/tourism-visit/visitor.html",
        "summary": "Citizens of Thailand require a B1/B2 non-immigrant visa for short-term tourism or business travel to the United States. This involves completing an online application (DS-160), paying a fee, and attending an in-person interview at the U.S. Embassy in Bangkok. The visa allows for multiple entries, with the exact duration of stay determined by a Customs and Border Protection (CBP) officer upon arrival in the U.S.",
        "required_documents": [
          "Valid passport (valid for at least six months beyond your period of stay in the U.S.)",
          "Nonimmigrant Visa Application (DS-160) confirmation page",
          "Visa interview appointment confirmation page",
          "One 2x2 inch (5x5 cm) color photograph (taken within the last six months, meeting U.S. visa photo requirements)",
          "Proof of funds to cover your expenses during your stay (e.g., bank statements)",
          "Proof of strong ties to Thailand (e.g., employment letter, property deeds, family registration, business registration)",
          "Travel itinerary (optional, but recommended)",
          "Previous passports containing any prior U.S. visas (if applicable)"
        ],
        "steps": [
          {
            "step_number": 1,
            "title": "Complete the DS-160 Form",
            "description": "Fill out the online Nonimmigrant Visa Application (DS-160) form accurately and completely on the U.S. Department of State's Consular Electronic Application Center website."
          },
          {
            "step_number": 2,
            "title": "Pay the Visa Fee",
            "description": "Pay the non-refundable visa application fee (MRV fee) through the designated payment methods provided on the U.S. Embassy's visa service website for Thailand."
          },
          {
            "step_number": 3,
            "title": "Schedule an Interview",
            "description": "Create an account on the U.S. Embassy's visa service website and schedule your visa interview appointment at the U.S. Embassy in Bangkok. Be aware that wait times for appointments can be significant."
          },
          {
            "step_number": 4,
            "title": "Attend the Interview",
            "description": "Attend your scheduled interview at the U.S. Embassy in Bangkok, bringing all required documents. A consular officer will review your application and conduct a brief interview to determine your eligibility."
          },
          {
            "step_number": 5,
            "title": "Receive Your Passport",
            "description": "If your visa is approved, your passport with the visa will be delivered to your chosen address or pick-up location within a few business days after the interview."
          }
        ],
        "updated_at": "2026-09-03T10:22:39.185552"
      }
