      "TH_JP_th": {
        "from_country": "TH",
        "to_country": "JP",
        "lang": "th",
        "visa_type": "visa_free",
        "stay_duration": "สูงสุด 15 วัน",
        "processing_time": "ไม่จำเป็น (เนื่องจากได้รับการยกเว้นวีซ่า)",
        "estimated_cost": "ฟรี",
        "official_portal_url": "https://www.mofa.go.jp/j_info/visit/visa/short/novisa.html",
        "summary": "ผู้ถือหนังสือเดินทางไทยสามารถเดินทางเข้าประเทศญี่ปุ่นเพื่อวัตถุประสงค์ด้านการท่องเที่ยวหรือธุรกิจระยะสั้นได้โดยไม่ต้องขอวีซ่าเป็นระยะเวลาสูงสุด 15 วัน การพำนักต้องไม่เกินระยะเวลาที่กำหนดและต้องมีวัตถุประสงค์ที่ไม่ใช่การทำงานหรือการพำนักระยะยาว",
        "required_documents": [
          "หนังสือเดินทางที่มีอายุเหลือไม่น้อยกว่า 6 เดือน",
          "ตั๋วเครื่องบินไป-กลับ หรือตั๋วเครื่องบินเดินทางต่อไปยังประเทศที่สาม",
          "หลักฐานการจองที่พัก",
          "หลักฐานทางการเงินที่เพียงพอสำหรับการพำนักในญี่ปุ่น",
          "แผนการเดินทางโดยประมาณ"
        ],
        "steps": [
          {
            "step_number": 1,
            "title": "เตรียมเอกสารที่จำเป็น",
            "description": "ตรวจสอบให้แน่ใจว่าหนังสือเดินทางมีอายุเหลือเพียงพอ และเตรียมตั๋วเครื่องบินไป-กลับ หลักฐานการจองที่พัก และหลักฐานทางการเงินที่เพียงพอสำหรับการพำนัก"
          },
          {
            "step_number": 2,
            "title": "เดินทางเข้าประเทศญี่ปุ่น",
            "description": "เมื่อเดินทางถึงญี่ปุ่น ให้แสดงเอกสารที่จำเป็นต่อเจ้าหน้าที่ตรวจคนเข้าเมือง และแจ้งวัตถุประสงค์ของการเดินทางว่าเป็นเพื่อการท่องเที่ยวหรือธุรกิจระยะสั้น"
          },
          {
            "step_number": 3,
            "title": "ปฏิบัติตามเงื่อนไขการพำนัก",
            "description": "พำนักในญี่ปุ่นไม่เกิน 15 วัน และปฏิบัติตามกฎหมายและข้อบังคับของญี่ปุ่นอย่างเคร่งครัดตลอดระยะเวลาที่พำนัก"
          }
        ],
        "updated_at": "2026-09-03T10:30:52.649838"
